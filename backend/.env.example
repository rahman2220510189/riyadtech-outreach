# Copy to backend/.env and fill in locally. Never commit .env.
# On Render, set these on the service's Environment page instead.
# Do NOT set HOST or PORT on Render.

NODE_ENV=development
# Local only. Hosted: the server binds to 0.0.0.0 automatically.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000
# Public URL of the website (used later for unsubscribe links).
PUBLIC_BASE_URL=http://localhost:3000

# --- Login --------------------------------------------------------------------
# Long random value, different for local and production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=
# How many days a login lasts.
SESSION_DAYS=7
# Used only by `npm run seed:admin` (the password is typed there, hidden).
ADMIN_EMAIL=you@example.com

# --- Mail ---------------------------------------------------------------------
# Encrypts mailbox passwords and signs unsubscribe links. 32 random bytes; create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it: if it changes, saved mailbox passwords must be typed again and old unsubscribe links stop working.
ENCRYPTION_KEY=
# Groq (https://console.groq.com/keys, starts with gsk_): drafts study e-mails. Optional.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# false: nothing is sent to anybody except "send test to myself". Turn on only when told to.
SENDING_ENABLED=false

# --- Database (Neon) ---------------------------------------------------------
# Locally: use the Neon "dev" branch. Production values go only on Render.
# Neon console -> Connect -> Branch: dev -> "Connection pooling" ON -> copy:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Same dialog, "Connection pooling" OFF -> copy (no "-pooler" in the host):
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Max connections from this process (keep small on the free plan).
DB_POOL_MAX=5
# --- Data sources (defaults are the real public sources; change only for testing) ---
# OVERTURE_STAC_URL=https://stac.overturemaps.org
# GEONAMES_BASE_URL=https://download.geonames.org/export/dump
# Cache for downloaded data indexes (inside backend/data, which git ignores).
# DATA_CACHE_DIR=data/cache

# For `npm run test:int` only: the dev branch pooled URL (same as DATABASE_URL locally).
TEST_DATABASE_URL=
