{
  "name": "riyadtech-outreach-backend",
  "version": "0.11.0",
  "private": true,
  "description": "Riyad Tech Outreach: internal API and background worker",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/all.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "prisma generate",
    "test:int": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "tsx src/cli/db-check.ts",
    "seed:admin": "tsx src/cli/seed-admin.ts",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "tsx src/all.ts",
    "geonames:import": "tsx src/cli/geonames-import.ts",
    "finder": "tsx src/cli/finder.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "jobs:check": "tsx src/cli/jobs-check.ts",
    "study:check": "tsx src/cli/study-check.ts",
    "study:ai": "tsx src/cli/study-ai.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "mail:outbox": "tsx src/cli/mail-outbox.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/jwt": "10.2.4",
    "@fastify/rate-limit": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fflate": "0.8.3",
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2",
    "imapflow": "2.2.1",
    "libphonenumber-js": "1.13.16",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "robots-parser": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "smtp-server": "3.19.16",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
