# Copy to frontend/.env.local for local development. Never commit it.
# On Vercel, set these on the project's Environment Variables page.

# Where Next forwards /api/v1 requests (server side only, never sent to the browser).
BACKEND_URL=http://127.0.0.1:4000

# What the browser calls. Keep it relative so the login cookie stays same-site.
NEXT_PUBLIC_API_URL=/api/v1
